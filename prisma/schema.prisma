generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  uid          String    @id @default(uuid())
  displayName  String
  email        String    @unique
  passwordHash String
  photoURL     String?   @db.Text
  bio          String?   @db.Text
  role         String    @default("viewer")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  token        String?   @db.Text
  messages     Message[]
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String    @db.Text
  status       String    @default("active")
  clientName   String
  category     String?
  progress     Int       @default(0)
  deadline     DateTime?
  visibility   String    @default("public")
  allowedUsers Json?
  goals        Json?
  financials   String?   @db.Text
  history      String?   @db.Text
  projectUrl   String?
  coverImage   String?   @db.LongText
  logoUrl      String?   @db.LongText
  createdAt    DateTime  @default(now())
  features     Feature[]
  sprints      Sprint[]
  messages     Message[]
  clients      ClientProject[]
  payables     Payable[]
  images       ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String   @db.LongText
  caption   String?  @db.VarChar(255)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Feature {
  id          String   @id @default(uuid())
  key         String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?  @relation(fields: [sprintId], references: [id])
  title       String
  description String   @db.Text
  status      String   @default("todo")
  priority    String?  @default("medium")
  category    String?
  assignedTo  String?
  type        String   @default("task")
  tags        Json?
  points      Int      @default(1)
  deadline                DateTime?
  activities              String?  @db.Text
  testCases               String?  @db.LongText
  testEvidence            String?  @db.Text
  testObservations        String?  @db.Text
  reporter                String?
  functionalArea          String?
  acceptanceCriteria      String?  @db.Text
  functionalRequirements  String?  @db.Text
  businessRules           String?  @db.Text
  linkedDemandId          String?
  linkedDemandTitle       String?  @db.VarChar(512)
  createdAt               DateTime @default(now())

  comments FeatureComment[]
}

model FeatureComment {
  id         String   @id @default(uuid())
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  type       String   @default("comment") // comment | activity
  authorId   String?
  authorName String?
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([featureId])
}

model Sprint {
  id           String    @id @default(uuid())
  name         String
  goal         String?   @db.Text
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("planned")
  allowedUsers Json?
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features     Feature[]
  createdAt    DateTime  @default(now())
}

model Message {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [uid], onDelete: Cascade)
  senderName String
  text       String   @db.Text
  createdAt  DateTime @default(now())
}

model SiteValues {
  id      Int    @id @default(1)
  mission String @db.Text
  vision  String @db.Text
  values  Json
}

model TeamMember {
  id                     String  @id @default(uuid())
  name                   String
  role                   String
  bio                    String? @db.Text
  photoURL               String? @db.LongText
  linkedin               String?
  github                 String?
  instagram              String?
  specialty              String? @db.Text
  formation              String? @db.Text
  curiosities            String? @db.Text
  hobbies                String? @db.Text
  location               String?
  yearsExp               Int?
  mission                String? @db.Text
  missionPublic          Boolean @default(true)
  responsibilities       String? @db.Text
  responsibilitiesPublic Boolean @default(false)
  objectives             String? @db.Text
  objectivesPublic       Boolean @default(false)
  expectations           String? @db.Text
  expectationsPublic     Boolean @default(false)
  phrase                 String? @db.VarChar(512)
  phrasePublic           Boolean @default(true)
  isPublic               Boolean @default(true)
  order                  Int     @default(0)
}

model PortfolioItem {
  id          String  @id @default(uuid())
  title       String
  description String  @db.Text
  category    String?
  imageURL    String?
  link        String?
  order       Int     @default(0)
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  excerpt         String?        @db.Text
  content         String         @db.LongText
  coverImage      String?        @db.LongText
  status          String         @default("draft")
  featured        Boolean        @default(false)
  tags            String?        @db.Text
  views           Int            @default(0)
  readTimeMinutes Int            @default(1)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?        @db.Text
  seoKeywords     String?        @db.Text
  categoryId      String?
  authorId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        BlogCategory?  @relation(fields: [categoryId], references: [id])
  author          BlogAuthor?    @relation(fields: [authorId], references: [id])
  analytics       BlogAnalytics[]
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  color       String     @default("#6366f1")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  posts       BlogPost[]
}

model BlogAuthor {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  bio       String?    @db.Text
  photo     String?    @db.LongText
  role      String?
  linkedin  String?
  isActive  Boolean    @default(true)
  posts     BlogPost[]
}

model BlogAnalytics {
  id     String   @id @default(uuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  date   DateTime
  views  Int      @default(1)
}

model BlogSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Case {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  client          String
  excerpt         String?   @db.Text
  content         String    @db.LongText
  coverImage      String?   @db.LongText
  status          String    @default("draft")
  featured        Boolean   @default(false)
  tags            String?   @db.Text
  views           Int       @default(0)
  likes           Int       @default(0)
  readTimeMinutes Int       @default(1)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?   @db.Text
  seoKeywords     String?   @db.Text
  segment         String?   @db.Text
  services        String?   @db.Text
  results         String?   @db.Text
  challenge       String?   @db.Text
  solution        String?   @db.Text
  categoryId      String?
  category        CaseCategory? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CaseCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  color       String  @default("#6366f1")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  cases       Case[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO COMERCIAL
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  category    String
  type        String   @default("service") // product | plan | service
  price       Float    @default(0)
  currency    String   @default("BRL")
  active      Boolean  @default(true)
  features    Json?
  tags        Json?
  createdAt   DateTime @default(now())
}

model Sale {
  id              String    @id @default(uuid())
  clientName      String
  clientEmail     String?
  clientPhone     String?
  productId       String
  productName     String
  productCategory String    @default("")
  value           Float     @default(0)
  status          String    @default("lead") // lead | negotiation | won | lost | cancelled
  paymentMethod   String?
  notes           String?   @db.Text
  origin          String?
  soldById        String?   // uid do User (vendedor) responsável pela venda/comissão
  soldByName      String?   // nome do vendedor no momento da venda
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client     Client?
}

model ReadyMessage {
  id          String   @id @default(uuid())
  userId      String?  // null = mensagem global/padrão; preenchido = mensagem do usuário
  title       String
  category    String   @default("general")
  productId   String?
  productName String?
  body        String   @db.Text
  tags        Json?
  isDefault   Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Client {
  id                 String    @id @default(uuid())
  userId             String?   // dono/responsável (uid do User), opcional
  name               String
  email              String?
  phone              String?
  document           String?   // CPF/CNPJ opcional
  birthDate          DateTime?
  startDate          DateTime? // data de início de uso do sistema/serviço
  status             String    @default("active") // active | paused | cancelled
  saleId             String?   @unique // venda de origem (Sale.id), opcional
  billingValue       Float     @default(0)
  billingCycle       String    @default("monthly") // monthly | yearly | custom | one_time
  dueDay             Int?      // dia do mês de vencimento (1-31)
  nextDueDate        DateTime? // próxima data de vencimento
  reminderDaysBefore Int       @default(5)
  graceDaysAfter     Int       @default(7)
  soldById           String?   // uid do User (vendedor) responsável pela comissão
  soldByName         String?
  commissionType     String?   // percentage | fixed
  commissionValue    Float?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastPaidAt         DateTime? // última fatura paga (manual hoje, webhook do Asaas depois)
  asaasCustomerId     String?   @db.VarChar(40)  // cadastro do cliente no Asaas
  asaasSubscriptionId String?   @db.VarChar(40)  // assinatura recorrente no Asaas
  asaasBillingType    String?   @db.VarChar(20)  // UNDEFINED | PIX | BOLETO | CREDIT_CARD

  projects       ClientProject[]
  billingNotices ClientBillingNotice[]
  payments       ClientPayment[]
  asaasCharges   AsaasCharge[]
  receivables    Receivable[]
  sale           Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
}

// Histórico de recebimentos de cada cliente (manual hoje; o webhook do Asaas grava aqui depois)
model ClientPayment {
  id        String    @id @default(uuid())
  clientId  String
  amount    Float
  dueDate   DateTime? // vencimento a que o recebimento se refere
  paidAt    DateTime
  method    String?   @db.VarChar(40) // Pix, Boleto, Cartão, Asaas…
  asaasPaymentId String? @unique @db.VarChar(40) // evita registrar o mesmo pagamento do Asaas duas vezes
  notes     String?   @db.Text
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([paidAt])
}

// Avisos de cobrança já enviados por WhatsApp (evita mensagem repetida no mesmo ciclo)
model ClientBillingNotice {
  id       String   @id @default(uuid())
  clientId String
  kind     String   @db.VarChar(20) // reminder | due_today | overdue | blocked
  dueDate  DateTime // vencimento a que o aviso se refere
  sentAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, dueDate])
}

model Payable {
  id            String    @id @default(uuid())
  description   String
  type          String    @default("fixed") // fixed (custo fixo) | variable (valor muda) | normal (avulso) | product (sistema) | reimbursement
  projectId     String?   // qual sistema/produto, quando type = "product"
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount        Float     @default(0)
  dueDate       DateTime?
  paidDate      DateTime?
  status        String    @default("pending") // pending | partial | paid
  reimbursed    Boolean   @default(false)      // usado quando type = "reimbursement"
  notes         String?   @db.Text
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  installments  Int?      // qtd. de parcelas (ex.: compra parcelada)
  recurrence    String    @default("none") // none | monthly
  recurrenceCount Int?    // qtd. de meses da série (null = indefinida → gera 12 iniciais)
  interestRate  Float?    // % de juros se atrasar
  interestPeriod String?  // day | month | year
  finePercent   Float?    // % de multa se atrasar
  parentId      String?
  parent        Payable?  @relation("PayableSeries", fields: [parentId], references: [id], onDelete: Cascade)
  children      Payable[] @relation("PayableSeries")
  payments      PayablePayment[]
}

model PayablePayment {
  id        String   @id @default(uuid())
  payableId String
  payable   Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  method    String?
  notes     String?
  createdAt DateTime @default(now())
}

model ClientProject {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, projectId])
}

model ClientContact {
  id               String    @id @default(uuid())
  userId           String    // dono do contato (uid do User)
  clientName       String
  establishmentName String?
  ownerName        String?
  clientPhone      String?
  clientPhone2     String?
  clientEmail      String?
  city             String?
  segment          String?
  productName      String?
  messageId        String?
  messageTitle     String?
  channel          String    @default("whatsapp")
  status           String    @default("new")
  priority         String    @default("medium")
  notes            String?   @db.Text
  scheduledAt      DateTime?
  lastContactAt    DateTime?
  contactCount     Int       @default(0)
  createdAt        DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP BOT MÓDULO
// ─────────────────────────────────────────────────────────────────────────────

model WppInstance {
  id           String   @id @default(uuid())
  instanceName String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  status       String   @default("not_configured") @db.VarChar(30)
  qrCode       String?  @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WppBotConfig {
  id                    String   @id @default(uuid())
  botEnabled            Boolean  @default(false)
  sendWelcome           Boolean  @default(true)
  menuEnabled           Boolean  @default(false)
  useButtons            Boolean  @default(true)   // menus com botões nativos do WhatsApp (senão, texto numerado)
  menuWelcomeMsg        String?  @db.Text
  solutionsMsg          String?  @db.Text   // texto de "Conhecer nossas soluções"
  clientHelpMsg         String?  @db.Text   // texto de "Já sou cliente"
  menuOptions           String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WppBotSector {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)           // Ex: "Vendas", "Suporte"
  menuKey      String   @db.VarChar(10)             // Ex: "1", "2"
  description  String?  @db.VarChar(255)
  attendants   String   @db.Text                   // JSON array de atendentes
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations WppConversation[]
}

model WppBotFlowNode {
  id          String   @id @default(uuid())
  type        String   @db.VarChar(30) // welcome, menu, message, sector, input, end
  title       String   @db.VarChar(255)
  content     String?  @db.Text
  options     String?  @db.Text // JSON array [{key:"1", label:"Opção 1", nextNodeId:"xxx"}]
  sectorId    String?  @db.VarChar(36)
  inputVar    String?  @db.VarChar(50)
  nextNodeId  String?  @db.VarChar(36)
  isStart     Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  posX        Int      @default(0)
  posY        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WppConversation {
  id             String    @id @default(uuid())
  sectorId       String?   
  clientPhone    String    @db.VarChar(30)
  clientName     String?   @db.VarChar(255)
  attendantName  String?   @db.VarChar(100)
  attendantId    String?   @db.VarChar(36)
  attendantPhone String?   @db.VarChar(30)   // preenchido quando o atendente conversa pelo próprio WhatsApp
  acceptedAt     DateTime?
  queuedAt       DateTime  @default(now())   // quando entrou (ou voltou) para a fila
  status         String    @default("waiting") @db.VarChar(20) // waiting, active, closed
  firstMessage   String?   @db.VarChar(1000)
  closedBy       String?   @db.VarChar(20)  // attendant, client, system
  closedAt       DateTime? 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sector   WppBotSector?        @relation(fields: [sectorId], references: [id])
  messages WppConversationMessage[]
}

model WppConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   
  fromRole       String   @db.VarChar(20) // client, attendant, bot, system
  fromPhone      String?  @db.VarChar(30)
  body           String   @db.Text
  sentAt         DateTime @default(now())

  conversation WppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Avisos internos da equipe (bot manda por WhatsApp) ────────────────────────

// Pessoa da equipe que recebe avisos no próprio WhatsApp
model TeamRecipient {
  id                String   @id @default(uuid())
  name              String
  phone             String   @db.VarChar(30)
  userId            String?  @db.VarChar(36) // usuário do sistema, quando houver
  notifyPayables    Boolean  @default(true)  // resumo de contas a pagar
  notifyReceivables Boolean  @default(true)  // resumo de contas a receber
  notifyMeetings    Boolean  @default(true)  // lembrete de reuniões
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  meetings MeetingAttendee[]
}

model Meeting {
  id             String    @id @default(uuid())
  title          String
  startsAt       DateTime
  location       String?   @db.VarChar(255) // link ou local
  notes          String?   @db.Text
  createdById    String?
  createdByName  String?
  reminderSentAt DateTime? // quando o lembrete de 24h foi enviado
  createdAt      DateTime  @default(now())

  attendees MeetingAttendee[]

  @@index([startsAt])
}

model MeetingAttendee {
  id          String        @id @default(uuid())
  meetingId   String
  recipientId String
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recipient   TeamRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([meetingId, recipientId])
}

// Evita mandar o mesmo resumo duas vezes no mesmo dia
model TeamNoticeLog {
  id     String   @id @default(uuid())
  key    String   @unique @db.VarChar(120) // ex.: payables:<recipientId>:2026-10-02
  sentAt DateTime @default(now())
}

// Conta a receber avulsa: qualquer valor que a empresa tem a receber (serviço, venda parcelada, reembolso…).
// As assinaturas dos clientes aparecem junto na tela, mas vivem em Client.
model Receivable {
  id                String    @id @default(uuid())
  description       String
  amount            Float
  dueDate           DateTime
  status            String    @default("pending") // pending | received
  receivedAt        DateTime?
  receivedAmount    Float?
  method            String?   @db.VarChar(40)
  notes             String?   @db.Text
  clientId          String?   @db.VarChar(36) // vínculo opcional com um cliente
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payerName         String?   // quem vai pagar, quando não é um cliente cadastrado
  groupId           String?   @db.VarChar(36) // parcelas do mesmo lançamento
  installmentNo     Int?
  installmentsTotal Int?
  createdById       String?
  createdByName     String?
  createdAt         DateTime  @default(now())

  @@index([dueDate])
  @@index([groupId])
}

// Cobranças geradas no Asaas (uma por vencimento). Guarda o link para o bot mandar ao cliente.
model AsaasCharge {
  id             String    @id @default(uuid())
  clientId       String
  asaasPaymentId String    @unique @db.VarChar(40)
  value          Float
  dueDate        DateTime
  status         String    @db.VarChar(30) // PENDING | RECEIVED | CONFIRMED | OVERDUE | REFUNDED | DELETED …
  billingType    String?   @db.VarChar(20)
  invoiceUrl     String?   @db.Text
  bankSlipUrl    String?   @db.Text
  receiptUrl     String?   @db.Text
  paidAt         DateTime?
  linkSentAt     DateTime? // quando o bot mandou o link ao cliente
  receiptSentAt  DateTime? // quando o bot mandou o comprovante
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Registro dos avisos (webhooks) recebidos do Asaas, para conferir se a integração está funcionando
model AsaasWebhookLog {
  id             String   @id @default(uuid())
  event          String   @db.VarChar(60)
  asaasPaymentId String?  @db.VarChar(40)
  clientName     String?
  outcome        String   @db.VarChar(160) // o que o sistema fez com o aviso
  payload        String?  @db.Text         // cobrança enviada pelo Asaas (para reprocessar)
  ok             Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ─── Eventos do sistema e webhooks de saída ─────────────────────────────────────
// Toda criação/alteração/exclusão em qualquer tabela vira um SystemEvent (ver src/backend/db.ts).
// Eles alimentam a atualização automática das telas e a entrega aos endpoints cadastrados.

model SystemEvent {
  id           Int       @id @default(autoincrement())
  model        String    @db.VarChar(60)
  action       String    @db.VarChar(20)   // created | updated | deleted
  recordId     String?   @db.VarChar(64)
  data         String?   @db.Text          // registro (sem senhas/tokens, textos longos cortados)
  source       String?   @db.VarChar(20)   // api | worker
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?                    // quando foi distribuído aos webhooks de saída

  @@index([dispatchedAt])
  @@index([createdAt])
}

// Endereço de outro sistema que quer ser avisado de tudo (ou de parte) do que acontece aqui
model WebhookEndpoint {
  id        String   @id @default(uuid())
  name      String
  url       String   @db.VarChar(500)
  secret    String   @db.VarChar(80)       // assina cada envio (HMAC SHA-256)
  events    String   @db.Text              // JSON: ["*"] ou ["client.*", "payable.created"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  endpointId     String
  eventId        Int
  event          String    @db.VarChar(80)  // ex.: client.created
  status         String    @default("pending") @db.VarChar(15) // pending | success | failed
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?   @db.VarChar(300)
  durationMs     Int?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}
