generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  uid          String    @id @default(uuid())
  displayName  String
  email        String    @unique
  passwordHash String
  photoURL     String?   @db.Text
  bio          String?   @db.Text
  teamMemberId String?   @db.VarChar(36) // ligação com a página pública "Nossa Equipe" (foto e descrição vêm de lá)
  role         String    @default("viewer")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  token        String?   @db.Text
  messages     Message[]
}

model Project {
  id           String    @id @default(uuid())
  name         String
  description  String    @db.Text
  status       String    @default("active")
  clientName   String
  category     String?
  progress     Int       @default(0)
  deadline     DateTime?
  visibility   String    @default("public")
  allowedUsers Json?
  goals        Json?
  financials   String?   @db.Text
  history      String?   @db.Text
  projectUrl   String?
  coverImage   String?   @db.LongText
  logoUrl      String?   @db.LongText
  createdAt    DateTime  @default(now())
  features     Feature[]
  sprints      Sprint[]
  messages     Message[]
  clients      ClientProject[]
  payables     Payable[]
  images       ProjectImage[]
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String   @db.LongText
  caption   String?  @db.VarChar(255)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Feature {
  id          String   @id @default(uuid())
  key         String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprintId    String?
  sprint      Sprint?  @relation(fields: [sprintId], references: [id])
  title       String
  description String   @db.Text
  status      String   @default("todo")
  priority    String?  @default("medium")
  category    String?
  assignedTo  String?
  type        String   @default("task")
  tags        Json?
  points      Int      @default(1)
  deadline                DateTime?
  activities              String?  @db.Text
  testCases               String?  @db.LongText
  testEvidence            String?  @db.Text
  testObservations        String?  @db.Text
  reporter                String?
  functionalArea          String?
  acceptanceCriteria      String?  @db.Text
  functionalRequirements  String?  @db.Text
  businessRules           String?  @db.Text
  collaborators           Json?    // pessoas que trabalham em parceria com o responsável: ["Nome", ...]
  linkedDemandId          String?
  linkedDemandTitle       String?  @db.VarChar(512)
  createdAt               DateTime @default(now())

  comments FeatureComment[]
}

model FeatureComment {
  id         String   @id @default(uuid())
  featureId  String
  feature    Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  type       String   @default("comment") // comment | activity
  authorId   String?
  authorName String?
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([featureId])
}

model Sprint {
  id           String    @id @default(uuid())
  name         String
  goal         String?   @db.Text
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("planned")
  allowedUsers Json?
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  features     Feature[]
  createdAt    DateTime  @default(now())
}

model Message {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [uid], onDelete: Cascade)
  senderName String
  text       String   @db.Text
  createdAt  DateTime @default(now())
}

model SiteValues {
  id      Int    @id @default(1)
  mission String @db.Text
  vision  String @db.Text
  values  Json
}

model TeamMember {
  id                     String  @id @default(uuid())
  name                   String
  role                   String
  bio                    String? @db.Text
  photoURL               String? @db.LongText
  linkedin               String?
  github                 String?
  instagram              String?
  specialty              String? @db.Text
  formation              String? @db.Text
  curiosities            String? @db.Text
  hobbies                String? @db.Text
  location               String?
  yearsExp               Int?
  mission                String? @db.Text
  missionPublic          Boolean @default(true)
  responsibilities       String? @db.Text
  responsibilitiesPublic Boolean @default(false)
  objectives             String? @db.Text
  objectivesPublic       Boolean @default(false)
  expectations           String? @db.Text
  expectationsPublic     Boolean @default(false)
  phrase                 String? @db.VarChar(512)
  phrasePublic           Boolean @default(true)
  isPublic               Boolean @default(true)
  order                  Int     @default(0)
}

model PortfolioItem {
  id          String  @id @default(uuid())
  title       String
  description String  @db.Text
  category    String?
  imageURL    String?
  link        String?
  order       Int     @default(0)
}

model BlogPost {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  excerpt         String?        @db.Text
  content         String         @db.LongText
  coverImage      String?        @db.LongText
  status          String         @default("draft")
  featured        Boolean        @default(false)
  tags            String?        @db.Text
  views           Int            @default(0)
  readTimeMinutes Int            @default(1)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?        @db.Text
  seoKeywords     String?        @db.Text
  categoryId      String?
  authorId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  category        BlogCategory?  @relation(fields: [categoryId], references: [id])
  author          BlogAuthor?    @relation(fields: [authorId], references: [id])
  analytics       BlogAnalytics[]
}

model BlogCategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  color       String     @default("#6366f1")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  posts       BlogPost[]
}

model BlogAuthor {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  bio       String?    @db.Text
  photo     String?    @db.LongText
  role      String?
  linkedin  String?
  isActive  Boolean    @default(true)
  posts     BlogPost[]
}

model BlogAnalytics {
  id     String   @id @default(uuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  date   DateTime
  views  Int      @default(1)
}

model BlogSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Case {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  client          String
  excerpt         String?   @db.Text
  content         String    @db.LongText
  coverImage      String?   @db.LongText
  status          String    @default("draft")
  featured        Boolean   @default(false)
  tags            String?   @db.Text
  views           Int       @default(0)
  likes           Int       @default(0)
  readTimeMinutes Int       @default(1)
  publishedAt     DateTime?
  seoTitle        String?
  seoDescription  String?   @db.Text
  seoKeywords     String?   @db.Text
  segment         String?   @db.Text
  services        String?   @db.Text
  results         String?   @db.Text
  challenge       String?   @db.Text
  solution        String?   @db.Text
  categoryId      String?
  category        CaseCategory? @relation(fields: [categoryId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model CaseCategory {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  color       String  @default("#6366f1")
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  cases       Case[]
}

// ─────────────────────────────────────────────────────────────────────────────
// MÓDULO COMERCIAL
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  category    String
  type        String   @default("service") // product | plan | service
  price       Float    @default(0)
  currency    String   @default("BRL")
  active      Boolean  @default(true)
  supportEnabled Boolean @default(true) // aparece como opção no menu de suporte do bot
  features    Json?
  tags        Json?
  createdAt   DateTime @default(now())
}

model Sale {
  id              String    @id @default(uuid())
  clientName      String
  clientEmail     String?
  clientPhone     String?
  productId       String
  productName     String
  productCategory String    @default("")
  value           Float     @default(0)
  status          String    @default("lead") // lead | negotiation | won | lost | cancelled
  paymentMethod   String?
  notes           String?   @db.Text
  origin          String?
  soldById        String?   // uid do User (vendedor) responsável pela venda/comissão
  soldByName      String?   // nome do vendedor no momento da venda
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client     Client?
}

model ReadyMessage {
  id          String   @id @default(uuid())
  userId      String?  // null = mensagem global/padrão; preenchido = mensagem do usuário
  title       String
  category    String   @default("general")
  productId   String?
  productName String?
  body        String   @db.Text
  tags        Json?
  isDefault   Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Client {
  id                 String    @id @default(uuid())
  userId             String?   // dono/responsável (uid do User), opcional
  name               String    // nome do cliente (pessoa)
  businessName       String?   @db.VarChar(150) // nome do estabelecimento/empresa
  email              String?
  phone              String?
  document           String?   // CPF/CNPJ opcional
  birthDate          DateTime?
  startDate          DateTime? // data de início de uso do sistema/serviço
  status             String    @default("active") // active | paused | cancelled
  inTrial            Boolean   @default(false) // período de teste: não gera fatura, não envia cobrança e não é bloqueado/pausado sozinho
  trialEndsAt        DateTime? // fim do período de teste
  saleId             String?   @unique // venda de origem (Sale.id), opcional
  billingValue       Float     @default(0)
  billingCycle       String    @default("monthly") // monthly | yearly | custom | one_time
  dueDay             Int?      // dia do mês de vencimento (1-31)
  nextDueDate        DateTime? // próxima data de vencimento
  reminderDaysBefore Int       @default(5)
  graceDaysAfter     Int       @default(7)
  soldById           String?   // uid do User (vendedor) responsável pela comissão
  soldByName         String?
  commissionType     String?   // percentage | fixed
  commissionValue    Float?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastPaidAt         DateTime? // última fatura paga (manual hoje, webhook do Asaas depois)
  asaasCustomerId     String?   @db.VarChar(40)  // cadastro do cliente no Asaas
  asaasSubscriptionId String?   @db.VarChar(40)  // assinatura recorrente no Asaas
  asaasBillingType    String?   @db.VarChar(20)  // UNDEFINED | PIX | BOLETO | CREDIT_CARD
  // Pix Automático (autorização única; o Asaas cobra sozinho nos meses seguintes)
  pixAutoId           String?   @db.VarChar(60)
  pixAutoStatus       String?   @db.VarChar(20)  // CREATED | ACTIVE | REFUSED | CANCELLED | EXPIRED
  pixAutoQr           String?   @db.Text         // JSON { payload, image } do QR da autorização
  // Loja do cliente no Store BoxSys (criada e bloqueada/liberada por este sistema)
  boxsysTenantId      String?   @db.VarChar(20)
  boxsysSubdomain     String?   @db.VarChar(80)
  boxsysUrl           String?   @db.VarChar(255)
  boxsysStatus        String?   @db.VarChar(20)  // active | suspended (último estado aplicado no BoxSys)
  boxsysSyncedAt      DateTime?
  boxsysError         String?   @db.VarChar(255)

  projects       ClientProject[]
  billingNotices ClientBillingNotice[]
  payments       ClientPayment[]
  asaasCharges   AsaasCharge[]
  receivables    Receivable[]
  sale           Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
}

// Histórico de recebimentos de cada cliente (manual hoje; o webhook do Asaas grava aqui depois)
model ClientPayment {
  id        String    @id @default(uuid())
  clientId  String
  amount    Float
  dueDate   DateTime? // vencimento a que o recebimento se refere
  paidAt    DateTime
  method    String?   @db.VarChar(40) // Pix, Boleto, Cartão, Asaas…
  asaasPaymentId String? @unique @db.VarChar(40) // evita registrar o mesmo pagamento do Asaas duas vezes
  notes     String?   @db.Text
  createdAt DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([paidAt])
}

// Avisos de cobrança já enviados por WhatsApp (evita mensagem repetida no mesmo ciclo)
model ClientBillingNotice {
  id       String   @id @default(uuid())
  clientId String
  kind     String   @db.VarChar(20) // reminder | due_today | overdue | blocked | block_pending
  dueDate  DateTime // vencimento a que o aviso se refere
  sentAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, dueDate])
}

model Payable {
  id            String    @id @default(uuid())
  description   String
  type          String    @default("fixed") // fixed (custo fixo) | variable (valor muda) | normal (avulso) | product (sistema) | reimbursement
  projectId     String?   // qual sistema/produto, quando type = "product"
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  amount        Float     @default(0)
  dueDate       DateTime?
  paidDate      DateTime?
  status        String    @default("pending") // pending | partial | paid
  reimbursed    Boolean   @default(false)      // usado quando type = "reimbursement"
  notes         String?   @db.Text
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  installments  Int?      // qtd. de parcelas (ex.: compra parcelada)
  recurrence    String    @default("none") // none | monthly
  recurrenceCount Int?    // qtd. de repetições da série (null = indefinida → gera as próximas conforme o tempo passa)
  recurrenceEvery Int     @default(1)        // a cada N (semanas, meses ou anos)
  recurrenceUnit  String  @default("month") @db.VarChar(10) // week | month | year
  interestRate  Float?    // % de juros se atrasar
  interestPeriod String?  // day | month | year
  finePercent   Float?    // % de multa se atrasar
  parentId      String?
  parent        Payable?  @relation("PayableSeries", fields: [parentId], references: [id], onDelete: Cascade)
  children      Payable[] @relation("PayableSeries")
  payments      PayablePayment[]
}

model PayablePayment {
  id        String   @id @default(uuid())
  payableId String
  payable   Payable  @relation(fields: [payableId], references: [id], onDelete: Cascade)
  amount    Float
  date      DateTime
  method    String?
  notes     String?
  createdAt DateTime @default(now())
}

model ClientProject {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, projectId])
}

model ClientContact {
  id               String    @id @default(uuid())
  userId           String    // dono do contato (uid do User)
  clientName       String
  establishmentName String?
  ownerName        String?
  clientPhone      String?
  clientPhone2     String?
  clientEmail      String?
  city             String?
  segment          String?
  productName      String?
  messageId        String?
  messageTitle     String?
  channel          String    @default("whatsapp")
  status           String    @default("new")
  priority         String    @default("medium")
  notes            String?   @db.Text
  scheduledAt      DateTime?
  lastContactAt    DateTime?
  contactCount     Int       @default(0)
  createdAt        DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// WHATSAPP BOT MÓDULO
// ─────────────────────────────────────────────────────────────────────────────

model WppInstance {
  id           String   @id @default(uuid())
  instanceName String   @db.VarChar(120)
  phone        String?  @db.VarChar(30)
  status       String   @default("not_configured") @db.VarChar(30)
  qrCode       String?  @db.Text
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WppBotConfig {
  id                    String   @id @default(uuid())
  botEnabled            Boolean  @default(false)
  sendWelcome           Boolean  @default(true)
  menuEnabled           Boolean  @default(false)
  useButtons            Boolean  @default(true)   // menus com botões nativos do WhatsApp (senão, texto numerado)
  menuWelcomeMsg        String?  @db.Text
  solutionsMsg          String?  @db.Text   // texto de "Conhecer nossas soluções"
  clientHelpMsg         String?  @db.Text   // texto de "Já sou cliente"
  menuOptions           String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model WppBotSector {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)           // Ex: "Vendas", "Suporte"
  menuKey      String   @db.VarChar(10)             // Ex: "1", "2"
  description  String?  @db.VarChar(255)
  attendants   String   @db.Text                   // JSON array de atendentes
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  intake       String   @default("none") @db.VarChar(20) // none | support (pede sistema, CPF/CNPJ e assunto antes da fila)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations WppConversation[]
}

model WppBotFlowNode {
  id          String   @id @default(uuid())
  type        String   @db.VarChar(30) // welcome, menu, message, sector, input, end
  title       String   @db.VarChar(255)
  content     String?  @db.Text
  options     String?  @db.Text // JSON array [{key:"1", label:"Opção 1", nextNodeId:"xxx"}]
  sectorId    String?  @db.VarChar(36)
  inputVar    String?  @db.VarChar(50)
  nextNodeId  String?  @db.VarChar(36)
  isStart     Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  posX        Int      @default(0)
  posY        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WppConversation {
  id             String    @id @default(uuid())
  sectorId       String?   
  clientPhone    String    @db.VarChar(30)
  clientJid      String?   @db.VarChar(80)    // endereço original no WhatsApp (pode ser um ID interno @lid, não o telefone)
  clientName     String?   @db.VarChar(255)
  attendantName  String?   @db.VarChar(100)
  attendantId    String?   @db.VarChar(36)
  attendantPhone String?   @db.VarChar(30)   // preenchido quando o atendente conversa pelo próprio WhatsApp
  acceptedAt     DateTime?
  queuedAt       DateTime  @default(now())   // quando entrou (ou voltou) para a fila
  status         String    @default("waiting") @db.VarChar(20) // bot, waiting, active, closed
  firstMessage   String?   @db.VarChar(1000)
  subject        String?   @db.VarChar(255)   // sistema/assunto escolhido no suporte
  clientDocument String?   @db.VarChar(20)    // CPF/CNPJ informado
  linkedClientId String?   @db.VarChar(36)    // cliente cadastrado encontrado pelo documento
  outbound       Boolean   @default(false)   // começou por nós (prospecção/disparo): o bot não manda lembrete nem aviso de encerramento
  closedBy       String?   @db.VarChar(20)  // attendant, client, system
  closedAt       DateTime? 
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sector   WppBotSector?        @relation(fields: [sectorId], references: [id])
  messages WppConversationMessage[]
}

model WppConversationMessage {
  id             String   @id @default(uuid())
  conversationId String   
  fromRole       String   @db.VarChar(20) // client, attendant, bot, system
  fromPhone      String?  @db.VarChar(30)
  body           String   @db.Text
  sentAt         DateTime @default(now())

  conversation WppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ─── Avisos internos da equipe (bot manda por WhatsApp) ────────────────────────

// Pessoa da equipe que recebe avisos no próprio WhatsApp
model TeamRecipient {
  id                String   @id @default(uuid())
  name              String
  phone             String   @db.VarChar(30)
  userId            String?  @db.VarChar(36) // usuário do sistema, quando houver
  notifyPayables    Boolean  @default(true)  // resumo de contas a pagar
  notifyReceivables Boolean  @default(true)  // resumo de contas a receber
  notifyMeetings    Boolean  @default(true)  // lembrete de reuniões
  notifyBirthdays   Boolean  @default(true)  // aniversário de sócios e clientes
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  meetings MeetingAttendee[]
}

model Meeting {
  id             String    @id @default(uuid())
  title          String
  startsAt       DateTime
  location       String?   @db.VarChar(255) // link ou local
  notes          String?   @db.Text
  createdById    String?
  createdByName  String?
  reminderSentAt DateTime? // quando o lembrete de 24h foi enviado
  createdAt      DateTime  @default(now())

  attendees MeetingAttendee[]

  @@index([startsAt])
}

model MeetingAttendee {
  id          String        @id @default(uuid())
  meetingId   String
  recipientId String
  meeting     Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  recipient   TeamRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([meetingId, recipientId])
}

// Evita mandar o mesmo resumo duas vezes no mesmo dia
model TeamNoticeLog {
  id     String   @id @default(uuid())
  key    String   @unique @db.VarChar(120) // ex.: payables:<recipientId>:2026-10-02
  sentAt DateTime @default(now())
}

// Conta a receber avulsa: qualquer valor que a empresa tem a receber (serviço, venda parcelada, reembolso…).
// As assinaturas dos clientes aparecem junto na tela, mas vivem em Client.
model Receivable {
  id                String    @id @default(uuid())
  description       String
  amount            Float
  dueDate           DateTime
  status            String    @default("pending") // pending | received
  receivedAt        DateTime?
  receivedAmount    Float?
  method            String?   @db.VarChar(40)
  notes             String?   @db.Text
  clientId          String?   @db.VarChar(36) // vínculo opcional com um cliente
  client            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  payerName         String?   // quem vai pagar, quando não é um cliente cadastrado
  groupId           String?   @db.VarChar(36) // parcelas do mesmo lançamento
  installmentNo     Int?
  installmentsTotal Int?
  createdById       String?
  createdByName     String?
  createdAt         DateTime  @default(now())

  @@index([dueDate])
  @@index([groupId])
}

// Cobranças geradas no Asaas (uma por vencimento). Guarda o link para o bot mandar ao cliente.
model AsaasCharge {
  id             String    @id @default(uuid())
  clientId       String
  asaasPaymentId String    @unique @db.VarChar(40)
  value          Float
  dueDate        DateTime
  status         String    @db.VarChar(30) // PENDING | RECEIVED | CONFIRMED | OVERDUE | REFUNDED | DELETED …
  billingType    String?   @db.VarChar(20)
  invoiceUrl     String?   @db.Text
  bankSlipUrl    String?   @db.Text
  receiptUrl     String?   @db.Text
  paidAt         DateTime?
  linkSentAt     DateTime? // quando o bot mandou o link ao cliente
  receiptSentAt  DateTime? // quando o bot mandou o comprovante
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// Registro dos avisos (webhooks) recebidos do Asaas, para conferir se a integração está funcionando
model AsaasWebhookLog {
  id             String   @id @default(uuid())
  event          String   @db.VarChar(60)
  asaasPaymentId String?  @db.VarChar(40)
  clientName     String?
  outcome        String   @db.VarChar(160) // o que o sistema fez com o aviso
  payload        String?  @db.Text         // cobrança enviada pelo Asaas (para reprocessar)
  ok             Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ─── Eventos do sistema e webhooks de saída ─────────────────────────────────────
// Toda criação/alteração/exclusão em qualquer tabela vira um SystemEvent (ver src/backend/db.ts).
// Eles alimentam a atualização automática das telas e a entrega aos endpoints cadastrados.

model SystemEvent {
  id           Int       @id @default(autoincrement())
  model        String    @db.VarChar(60)
  action       String    @db.VarChar(20)   // created | updated | deleted
  recordId     String?   @db.VarChar(64)
  data         String?   @db.Text          // registro (sem senhas/tokens, textos longos cortados)
  source       String?   @db.VarChar(20)   // api | worker
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?                    // quando foi distribuído aos webhooks de saída

  @@index([dispatchedAt])
  @@index([createdAt])
}

// Endereço de outro sistema que quer ser avisado de tudo (ou de parte) do que acontece aqui
model WebhookEndpoint {
  id        String   @id @default(uuid())
  name      String
  url       String   @db.VarChar(500)
  secret    String   @db.VarChar(80)       // assina cada envio (HMAC SHA-256)
  events    String   @db.Text              // JSON: ["*"] ou ["client.*", "payable.created"]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  endpointId     String
  eventId        Int
  event          String    @db.VarChar(80)  // ex.: client.created
  status         String    @default("pending") @db.VarChar(15) // pending | success | failed
  attempts       Int       @default(0)
  nextAttemptAt  DateTime?
  lastStatusCode Int?
  lastError      String?   @db.VarChar(300)
  durationMs     Int?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// Base de conhecimento do bot: perguntas e respostas sobre os sistemas (editável no painel)
model WppBotKnowledge {
  id        String   @id @default(uuid())
  title     String   @db.VarChar(120)
  system    String?  @db.VarChar(80)
  phrases   String   @db.Text              // JSON: frases de exemplo que o cliente escreve
  keywords  String?  @db.Text              // JSON: [[palavra, peso]]
  answer    String   @db.Text              // variações da resposta separadas por uma linha "---"
  action    String   @default("reply") @db.VarChar(40) // reply | menu | support | handoff:Comercial …
  followUp  String?  @db.Text
  priority  Int      @default(5)
  enabled   Boolean  @default(true)
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// O que o bot não entendeu (ou entendeu com dúvida): ajuda a ensinar novas respostas
model WppBotNluLog {
  id         String   @id @default(uuid())
  text       String   @db.VarChar(500)
  intentId   String?  @db.VarChar(80)
  confidence Float    @default(0)
  outcome    String   @db.VarChar(10) // act | ask | none
  dismissed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([outcome, dismissed, createdAt])
}

// O que a BiIA lembra de cada contato de uma conversa para a outra (nome, ramo, assuntos)
model WppContactMemory {
  id         String   @id @default(uuid())
  phone      String   @unique @db.VarChar(40)
  name       String?  @db.VarChar(80)
  ramo       String?  @db.VarChar(80)
  topics     String?  @db.Text   // JSON: últimos assuntos
  visits     Int      @default(1)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// Prospecção: funil de leads (novo → contatado → reunião → proposta → ganho/perdido)
model Lead {
  id            String    @id @default(uuid())
  name          String    @db.VarChar(150) // pessoa de contato
  company       String?   @db.VarChar(150) // nome do estabelecimento/empresa
  phone         String?   @db.VarChar(40)
  email         String?   @db.VarChar(150)
  city          String?   @db.VarChar(100)
  source        String    @default("manual") @db.VarChar(40) // manual | indicacao | instagram | site | whatsapp | bia | planilha | outro
  product       String?   @db.VarChar(120) // produto de interesse
  priority      String    @default("warm") @db.VarChar(10) // hot | warm | cold (temperatura do lead)
  status        String    @default("new") @db.VarChar(20) // new | contacted | meeting | proposal | won | lost
  value         Float     @default(0) // valor mensal estimado
  nextFollowUp  DateTime? // próximo contato combinado
  lastContactAt DateTime?
  notes         String?   @db.Text
  lostReason    String?   @db.VarChar(200)
  clientId      String?   // cliente criado a partir deste lead
  placeId       String?   @db.VarChar(80) // empresa encontrada no Google Maps (evita cadastrar duas vezes)
  saleId        String?   // venda acompanhada em Vendas (nasce na reunião/proposta)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activities    LeadActivity[]

  @@index([status])
  @@index([nextFollowUp])
  @@index([placeId])
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String   @default("note") @db.VarChar(20) // note | call | whatsapp | email | meeting | status
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([leadId])
}

// Registro das mensagens disparadas pelo painel (prospecção, relacionamento e cobrança)
model OutreachLog {
  id        String   @id @default(uuid())
  phone     String   @db.VarChar(30) // só dígitos, sem o 55
  name      String?  @db.VarChar(150)
  source    String   @default("other") @db.VarChar(20) // lead | client | sale | contact | other
  refId     String?  @db.VarChar(64)
  via       String   @default("bot") @db.VarChar(20) // bot | attendant | link | billing
  message   String   @db.Text
  byName    String?  @db.VarChar(100)
  byEmail   String?  @db.VarChar(150) // login de quem enviou
  byId      String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([createdAt])
}

// Sociedade: sócios e a divisão do lucro (receitas recebidas menos despesas pagas, mês a mês)
model Partner {
  id              String   @id @default(uuid())
  name            String   @db.VarChar(120)
  sharePercent    Float    @default(0) // % do lucro distribuível
  email           String?  @db.VarChar(150)
  role            String?  @db.VarChar(80)
  color           String?  @db.VarChar(9)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  responsibilities String? @db.Text // o que esse sócio é responsável por fazer, na função dele
  birthDate       DateTime? // data de nascimento, para lembrete de aniversário
  createdAt       DateTime @default(now())

  goals       BusinessGoal[]
  evaluations PartnerEvaluation[]
}

model ProfitConfig {
  id                      String   @id @default("main")
  reservePercent          Float    @default(0)    // % do lucro que fica no caixa da empresa antes de dividir
  reimbursementsAsExpense Boolean  @default(true) // reembolsos pagos entram como despesa no cálculo
  updatedAt               DateTime @updatedAt
  basis                   String   @default("planned") @db.VarChar(10) // planned = tudo que vence no mes (a receber - a pagar) | cash = so o que ja entrou e saiu
  reimbursementPolicy      String   @default("debt_first") @db.VarChar(12) // debt_first = quita os reembolsos com o lucro antes de dividir | expense = reembolso e despesa | ignore = nao entra
}

// Fotografia de um mês fechado: os percentuais e valores daquele mês não mudam mesmo que a sociedade mude depois
model ProfitClosing {
  id            String   @id @default(uuid())
  month         String   @unique @db.VarChar(7) // AAAA-MM
  revenue       Float
  expenses      Float
  profit        Float
  reserve       Float
  distributable Float
  basis         String   @default("planned") @db.VarChar(10)
  debtPaid      Float    @default(0) // quanto do lucro quitou reembolsos devidos aos socios
  debtPayments  Json?    // pagamentos gerados no fechamento (para desfazer ao reabrir)
  shares        Json     // [{ partnerId, name, percent, amount, paid, paidAt }]
  notes         String?  @db.Text
  closedByName  String?  @db.VarChar(100)
  closedAt      DateTime @default(now())
}

// ─── Plano de Negócio ──────────────────────────────────────────────────────────
// Documento vivo da empresa: missão, análise, modelo de negócio e checklist jurídico/societário.
// É um "singleton" (uma linha só, id fixo "main"), igual ao ProfitConfig.
model BusinessPlan {
  id                String   @id @default("main")
  missionText       String?  @db.Text
  visionText        String?  @db.Text
  valuesText        String?  @db.Text
  swotStrengths     String?  @db.Text // forças
  swotWeaknesses    String?  @db.Text // fraquezas
  swotOpportunities String?  @db.Text // oportunidades
  swotThreats       String?  @db.Text // ameaças
  swotConclusion    String?  @db.Text // conclusão da análise SWOT: o que isso significa na prática
  targetMarket      String?  @db.Text // público-alvo / mercado
  businessModel     String?  @db.Text // como a Develoi ganha dinheiro (modelo SaaS, planos, etc.)
  legalChecklist    Json?    // [{ id, label, done }] — pontos jurídicos/societários comuns de empresa SaaS
  legalNotes        String?  @db.Text // observações sobre contrato social, regime tributário, LGPD, etc.
  updatedByName     String?  @db.VarChar(100)
  updatedAt         DateTime @updatedAt
}

// Histórico de alterações do Plano de Negócio: quem mudou o quê e quando
model BusinessPlanHistory {
  id            String   @id @default(uuid())
  changedByName String?  @db.VarChar(100)
  changes       Json     // [{ field, label, before, after }]
  changedAt     DateTime @default(now())
}

// Metas da empresa ou de um sócio específico, com acompanhamento de progresso
model BusinessGoal {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  scope       String    @default("company") @db.VarChar(10) // company | partner
  partnerId   String?
  partner     Partner?  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  targetDate  DateTime?
  status      String    @default("in_progress") @db.VarChar(15) // not_started | in_progress | done | at_risk
  progress    Int       @default(0) // 0 a 100
  priority     String    @default("medium") @db.VarChar(10) // low | medium | high
  category     String?   @db.VarChar(40)  // Financeiro, Comercial, Produto, Operação, Pessoas...
  startDate    DateTime? // quando a meta foi iniciada
  completedAt  DateTime? // quando foi concluída
  metricLabel  String?   @db.VarChar(80)  // o que se mede (ex.: clientes ativos, MRR)
  metricUnit   String?   @db.VarChar(12)  // R$, %, clientes, un
  startValue   Float?    // valor de partida
  currentValue Float?    // valor atual
  targetValue  Float?    // valor que se quer atingir
  steps        Json?     // passos: [{ id, text, done }]
  updates      Json?     // histórico de atualizações: [{ id, at, by, text, progress, value, status }]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Linha do tempo de conquistas da empresa
model Achievement {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  photoUrl    String?  @db.LongText
  achievedAt  DateTime
  createdAt   DateTime @default(now())
}

// Plano de ação: o que vamos fazer a partir de cada atualização da Análise SWOT
// Avaliação periódica de um sócio: pontos fortes, pontos a melhorar e metas para o próximo período
model PartnerEvaluation {
  id              String   @id @default(uuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  period          String   @db.VarChar(20) // ex: "2026-T4" ou "2026-10"
  score           Int?     // nota geral de 1 a 5
  strengths       String?  @db.Text
  improvements    String?  @db.Text
  goalsNextPeriod String?  @db.Text
  evaluatedByName String?  @db.VarChar(100)
  createdAt       DateTime @default(now())
}

// Consultas feitas ao Google Places por mês (trava de segurança para não passar da cota gratuita)
model PlacesUsage {
  month    String @id @db.VarChar(7) // AAAA-MM
  requests Int    @default(0)
}

// SWOT estruturada: cada fator tem categoria e uma avaliação manual de impacto, urgência e controle (1 a 5)
model SwotItem {
  id            String       @id @default(uuid())
  type          String       @db.VarChar(15) // strength | weakness | opportunity | threat
  title         String       @db.VarChar(300)
  note          String?      @db.Text         // observação estratégica
  impact        Int?         // 1 a 5, preenchido pelos sócios
  urgency       Int?         // 1 a 5
  control       Int?         // 1 a 5
  sortOrder     Int          @default(0)
  updatedByName String?      @db.VarChar(100)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  ratings       SwotRating[]

  @@index([type])
}

// Histórico das avaliações: permite ver como a percepção estratégica mudou
model SwotRating {
  id          String   @id @default(uuid())
  itemId      String
  item        SwotItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  impact      Int?
  urgency     Int?
  control     Int?
  note        String?  @db.Text
  ratedByName String?  @db.VarChar(100)
  ratedAt     DateTime @default(now())

  @@index([itemId])
}
