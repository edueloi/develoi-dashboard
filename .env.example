# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Opcional: a chave também pode ser cadastrada pelo painel em Bot > Inteligência.
GEMINI_API_KEY=""
# Chave estável usada para criptografar segredos salvos pelo painel. Gere um valor longo e aleatório.
APP_SECRETS_ENCRYPTION_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Asaas (cobrança automática por assinatura) ──
# Chave da API: Asaas > Integrações > Chave de API. Comece pelo sandbox (sandbox.asaas.com).
ASAAS_API_KEY=""
# "sandbox" para testar (padrão) ou "production" para cobrar de verdade
ASAAS_ENV="sandbox"
# Senha que o Asaas envia em cada webhook (invente uma, ex.: 32 letras e números)
ASAAS_WEBHOOK_TOKEN=""
# Endereço público do sistema, para o Asaas avisar os pagamentos. Ex.: https://painel.seudominio.com.br
PUBLIC_BASE_URL=""
# OPENAI_API_KEY: opcional. Alternativa ao Gemini para a BiIA (também pode ser salva pelo painel).
OPENAI_API_KEY=""
